app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/app/build/

# Barındırılan otobüs DB'si (tools/gtfs ile üretilir, Firebase Hosting'de canlı;
# repoya MB'larca ikili gömmeye gerek yok — manifest.json + index.html kalır)
firebase_hosting/data/*.sqlite
# Üretim ara çıktıları (fetch_official.py / merge_depar.py) ve ham GTFS
tools/gtfs/*.sqlite
tools/gtfs/*.csv
tools/gtfs/stop_times.txt
tools/kocaeli/raw/
tools/kocaeli/*.sqlite

# Yayın imzalama sırları — anahtar ve parolalar depoya girmez.
android/key.properties
*.jks
*.keystore

