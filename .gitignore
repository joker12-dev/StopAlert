# Gizli anahtarlar — ASLA commit'lenmez (MCP/Stitch API anahtarı burada)
.mcp.json
.env
*.env

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/app/build/

# Barındırılan otobüs DB'si (tools/gtfs ile üretilir, Firebase Hosting'de canlı;
# repoya 5MB'lık ikili gömmeye gerek yok — manifest.json + index.html kalır)
firebase_hosting/data/*.sqlite
