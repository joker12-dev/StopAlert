rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kullanıcı verisi: herkes yalnızca kendi ağacını okur/yazar
    // (profil, yolculuklar, favoriler — PLAN.md veri modeli).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Paylaşılan yolculuklar: link'i olan herkes okur;
    // yalnızca sahibi oluşturur/günceller/siler.
    match /shared_journeys/{sid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Kalabalık öğrenme: anonim segment-süresi toplamları (lineId/fromId/toId
    // + sumSeconds/count). Herkes okur (tohumlama); girişli kullanıcı katkı
    // verir. Kimlik yazılmaz. NOT: MVP istemci-tarafı toplama; abuse'a karşı
    // üretimde Cloud Functions ile sunucu tarafı toplama önerilir.
    match /segment_stats/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Canlı otobüs konumu — PAYLAŞIMLI ÖNBELLEK (bkz. LiveBusService).
    // İETT filo servisi saatte 100 istekle sınırlı; herkes doğrudan çağırırsa
    // kota dolar. Bu yüzden sonuç burada 30 sn önbelleklenir: herkes okur,
    // yalnızca önbellek bayatken bir istemci tazeler. Kişisel veri içermez
    // (araç kapı no + konum — İBB Açık Veri, kamuya açık).
    match /live_bus/{lineCode} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Parmak izi verisi (Faz 4): şimdilik kapalı.
    match /fingerprints/{doc} {
      allow read, write: if false;
    }
  }
}
